        <div class="text">      <p>  Estimated Delivery:  
           {% if product.metafields.custom.estimated_delivery != blank %}
               {% assign min_days = product.metafields.custom.delivery_min_days | default: 2 %}
                {% assign max_days = product.metafields.custom.delivery_max_days | default: 5 %}

                {% assign today = 'now' | date: "%s" %}
                {% assign min_date = today | plus: min_days | times: 86400 | date: "%d %B" %}
                {% assign max_date = today | plus: max_days | times: 86400 | date: "%d %B" %}
                 <strong>{{ min_date }} - {{ max_date }}</strong>
            {% else %}
                {% assign today = 'now' | date: "%s" | plus: 172800 | date: "%d %B" %}
                {% assign later = 'now' | date: "%s" | plus: 345600 | date: "%d %B" %}
                <strong> {{ today }} - {{ later }}</strong>
            {% endif %}
        </p></div>

</div>

