
{% liquid
  assign product        = block.settings.product
  assign show_countdown = block.settings.show_countdown_timer
  assign sale_end_mf    = product.metafields.custom.sale_end
-%}

{% capture children %}
  {%- if show_countdown and sale_end_mf != blank -%}
    {%- assign sale_end_iso = sale_end_mf | date: '%Y-%m-%dT%H:%M:%S' -%}
    <div
      class="pcd-countdown"
      id="pcd-{{ block.id }}"
      data-end="{{ sale_end_iso }}"
    >
      <div class="pcd-countdown__inner">
        <div class="pcd-countdown__block">
          <div class="pcd-countdown__num" data-pcd-days>00</div>
          <span class="pcd-countdown__label">Days</span>
        </div>
        <span class="pcd-countdown__sep" aria-hidden="true">:</span>
        <div class="pcd-countdown__block">
          <div class="pcd-countdown__num" data-pcd-hours>00</div>
          <span class="pcd-countdown__label">Hours</span>
        </div>
        <span class="pcd-countdown__sep" aria-hidden="true">:</span>
        <div class="pcd-countdown__block">
          <div class="pcd-countdown__num" data-pcd-mins>00</div>
          <span class="pcd-countdown__label">Mins</span>
        </div>
        <span class="pcd-countdown__sep" aria-hidden="true">:</span>
        <div class="pcd-countdown__block">
          <div class="pcd-countdown__num" data-pcd-secs>00</div>
          <span class="pcd-countdown__label">Sec</span>
        </div>
      </div>
    </div>

    <script>
    (function () {
      var id     = {{ block.id | json }};
      var endISO = {{ sale_end_iso | json }};

      function run() {
        var el = document.getElementById('pcd-' + id);
        if (!el) return;
        var endTime = new Date(endISO).getTime();
        if (isNaN(endTime) || endTime <= Date.now()) { if (el) el.style.display = 'none'; return; }

        function pad(n) { return ('0' + n).slice(-2); }
        function tick() {
          var diff = endTime - Date.now();
          if (diff <= 0) { el.style.display = 'none'; clearInterval(iv); return; }
          el.querySelector('[data-pcd-days]').textContent  = Math.floor(diff / 86400000);
          el.querySelector('[data-pcd-hours]').textContent = pad(Math.floor((diff % 86400000) / 3600000));
          el.querySelector('[data-pcd-mins]').textContent  = pad(Math.floor((diff % 3600000)  / 60000));
          el.querySelector('[data-pcd-secs]').textContent  = pad(Math.floor((diff % 60000)    / 1000));
        }
        tick();
        var iv = setInterval(tick, 1000);
      }

      if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', run); }
      else { run(); }
      document.addEventListener('shopify:section:load', run);
    })();
    </script>
  {%- endif -%}
  {% content_for 'blocks', closest.product: product %}
{% endcapture %}

{% render 'product-card', children: children, product: product %}

{% schema %}
{
  "name": "t:names.product_card",
  "blocks": [
    { "type": "_product-card-group" },
    { "type": "text" },
    { "type": "image" },
    { "type": "price" },
    { "type": "review" },
    { "type": "swatches" },
    { "type": "_product-card-gallery" },
    { "type": "product-title" },
    { "type": "count-down-timer" },
    { "type": "custom-liquid" },
    { "type": "@app" }
  ],
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "header",
      "content": "Countdown Timer"
    },
    {
      "type": "checkbox",
      "id": "show_countdown_timer",
      "label": "Show Countdown Timer",
      "info": "Shows automatically when the product has the metafield custom.sale_end set. Toggle ON to enable.",
      "default": false
    },
    {
      "type": "range",
      "id": "product_card_gap",
      "label": "t:settings.vertical_gap",
      "min": 0, "max": 50, "step": 1, "unit": "px", "default": 16
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    { "type": "header", "content": "t:content.borders" },
    {
      "type": "select", "id": "border", "label": "t:settings.style",
      "options": [
        { "value": "none",  "label": "t:options.none" },
        { "value": "solid", "label": "t:options.solid" }
      ],
      "default": "none"
    },
    { "type": "range", "id": "border_width",   "min": 0, "max": 100, "step": 1, "unit": "px", "label": "t:settings.thickness", "default": 1, "visible_if": "{{ block.settings.border != 'none' }}" },
    { "type": "range", "id": "border_opacity",  "min": 0, "max": 100, "step": 1, "unit": "%",  "label": "t:settings.opacity",   "default": 100, "visible_if": "{{ block.settings.border != 'none' }}" },
    { "type": "range", "id": "border_radius",   "min": 0, "max": 32,  "step": 1,               "label": "t:settings.border_radius", "default": 0 },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start",  "label": "t:settings.top",    "min": 0, "max": 50, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-block-end",    "label": "t:settings.bottom", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-inline-start", "label": "t:settings.left",   "min": 0, "max": 50, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-inline-end",   "label": "t:settings.right",  "min": 0, "max": 50, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "t:names.product_card",
      "category": "t:categories.product",
      "settings": { "product_card_gap": 4, "show_countdown_timer": false },
      "blocks": {
        "product-card-gallery": {
          "type": "_product-card-gallery",
          "settings": { "image_ratio": "adapt", "border": "none", "border_width": 1, "border_opacity": 100, "border_radius": 0, "padding-block-start": 0, "padding-block-end": 0, "padding-inline-start": 0, "padding-inline-end": 0 }
        },
        "product_title": {
          "type": "product-title",
          "name": "t:names.product_title",
          "settings": { "width": "fit-content", "max_width": "normal", "alignment": "left", "type_preset": "rte", "font": "var(--font-body--family)", "font_size": "1rem", "line_height": "normal", "letter_spacing": "normal", "case": "none", "wrap": "pretty", "color": "var(--color-foreground)", "background": false, "background_color": "#00000026", "corner_radius": 0, "padding-block-start": 4, "padding-block-end": 0, "padding-inline-start": 0, "padding-inline-end": 0 }
        },
        "price": {
          "type": "price",
          "name": "t:names.product_price",
          "settings": { "show_sale_price_first": true, "show_installments": false, "show_tax_info": false, "type_preset": "h6", "width": "100%", "alignment": "left", "font": "var(--font-body--family)", "font_size": "1rem", "line_height": "normal", "letter_spacing": "normal", "case": "none", "color": "var(--color-foreground)", "padding-block-start": 0, "padding-block-end": 0, "padding-inline-start": 0, "padding-inline-end": 0 }
        }
      },
      "block_order": ["product-card-gallery", "product_title", "price"]
    }
  ]
}
{% endschema %}

<style>
/* =============================================
   PRODUCT CARD — COUNTDOWN TIMER (Figma-matched)
   ============================================= */
.pcd-countdown {
  width: 100%;
  background: rgba(240, 240, 240, 0.5);
}
.pcd-countdown__inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  padding: 20px;
  width: 100%;
  box-sizing: border-box;
}
.pcd-countdown__block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}
.pcd-countdown__num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68px;
  padding: 10px;
  background: rgba(0, 0, 0, 0.5);
  font-family: "Roboto", sans-serif;
  font-weight: 700;
  font-size: 40px;
  line-height: 48px;
  text-align: center;
  color: #ffffff;
  box-sizing: border-box;
}
.pcd-countdown__label {
  font-family: "Roboto", sans-serif;
  font-weight: 500;
  font-size: 18px;
  line-height: 21.6px;
  text-align: center;
  color: #434377;
  white-space: nowrap;
}
.pcd-countdown__sep {
  font-family: "Roboto", sans-serif;
  font-weight: 700;
  font-size: 40px;
  line-height: 48px;
  color: #ffffff;
  align-self: flex-start;
  padding-top: 10px;
  text-shadow: 0 1px 4px rgba(0,0,0,0.5);
}
@media screen and (max-width: 989px) and (min-width: 750px) {
  .pcd-countdown__inner { gap: 12px; padding: 14px 10px; }
  .pcd-countdown__num   { width: 52px; font-size: 28px; line-height: 36px; padding: 8px; }
  .pcd-countdown__sep   { font-size: 28px; line-height: 36px; padding-top: 8px; }
  .pcd-countdown__label { font-size: 14px; }
}
@media (max-width: 749px) {
  .pcd-countdown__inner { gap: 8px; padding: 10px 8px; }
  .pcd-countdown__num   { width: 44px; font-size: 22px; line-height: 28px; padding: 6px; }
  .pcd-countdown__sep   { font-size: 22px; line-height: 28px; padding-top: 6px; }
  .pcd-countdown__label { font-size: 11px; line-height: 14px; }
}
@media (max-width: 400px) {
  .pcd-countdown__inner { gap: 5px; padding: 8px 4px; }
  .pcd-countdown__num   { width: 36px; font-size: 18px; line-height: 24px; padding: 4px; }
  .pcd-countdown__sep   { font-size: 18px; line-height: 24px; padding-top: 4px; }
  .pcd-countdown__label { font-size: 10px; }
}
</style>
