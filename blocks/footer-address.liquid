{% assign block_settings = block.settings %}
{% assign icon_block_class = 'icon-block__media icon-block-' | append: block.id %}
<summary class="footer-block__details-content heading {{ block_settings.heading_preset }} menu__heading">
  <span>{{ block_settings.heading }}</span>
  <span class="menu__heading__toggle svg-wrapper icon-caret icon-animated">
           {% comment %} {{- 'icon-caret.svg' | inline_asset_content -}} {% endcomment %}
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="9" viewBox="0 0 15 9" fill="none">
              <path opacity="0.5" d="M0.369955 0.370064C0.123318 0.616701 0 0.930602 0 1.31177C0 1.69293 0.123318 2.00683 0.369955 2.25347L6.5583 8.44181C6.69282 8.57634 6.83856 8.67186 6.99551 8.72836C7.15247 8.78396 7.32063 8.81177 7.5 8.81177C7.67937 8.81177 7.85336 8.77814 8.02197 8.71087C8.18968 8.64361 8.3296 8.55392 8.4417 8.44181L14.63 2.25347C14.8767 2.00683 15 1.69293 15 1.31177C15 0.930602 14.8767 0.616701 14.63 0.370064C14.3834 0.123427 14.0695 0.000107765 13.6883 0.000107765C13.3072 0.000107765 12.9933 0.123427 12.7466 0.370064L7.5 5.6167L2.25336 0.370064C2.00673 0.123427 1.69282 0.000107765 1.31166 0.000107765C0.930493 0.000107765 0.616591 0.123427 0.369955 0.370064Z" fill="white"/>
            </svg>
          </span>
  </summary>
<div class="footer-block__details-content contact-info address rte "> 
    {% capture icon %}
    {% render 'icon-or-image',
        icon: block_settings.icon_address,
        image_upload: block_settings.image_upload_address,
        width: block_settings.width_address,
        class_name: icon_block_class,
        attributes: block.shopify_attributes
    %}
    {% endcapture %}

    {%- if block_settings.link_address != blank -%}
    <a
        href="{{ block_settings.link_address }}"
        class="text-inherit"
        {% if block_settings.open_in_new_tab_address %}
        target="_blank" rel="noopener"
        {% endif %}
    >
        {{ icon }}
    </a>
    {%- else -%}
    {{ icon }}
    {%- endif -%}  
  {{ block.settings.text_address }}
</div>

<div class="footer-block__details-content contact-info email rte">
    {% capture icon %}
    {% render 'icon-or-image',
        icon: block_settings.icon_mail,
        image_upload: block_settings.image_upload_mail,
        width: block_settings.width_mail,
        class_name: icon_block_class,
        attributes: block.shopify_attributes
    %}
    {% endcapture %}

    {%- if block_settings.link_mail != blank -%}
    <a
        href="{{ block_settings.link_mail }}"
        class="text-inherit"
        {% if block_settings.open_in_new_tab_mail %}
        target="_blank" rel="noopener"
        {% endif %}
    >
        {{ icon }}
    </a>
    {%- else -%}
    {{ icon }}
    {%- endif -%}
    {{ block.settings.text_mail }}
</div>
{% stylesheet %}
.footer-block__details-content svg path{
  fill: currentColor;
}
.contact-info{
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}
.contact-info p{
  margin-top:0;
}


/* Rotate icon when open */
/* .footer-accordion[open] > summary::after {
  transform: rotate(180deg);
} */
.footer-accordion {
  overflow: hidden;
}

.footer-accordion__content {
  overflow: hidden;
  transition: height 0.35s ease;
}

/* Mobile only */
@media (max-width: 749px) {
  .footer-accordion > summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.contact-column .shopify-block{
  width:100%;
}
details[open]>summary .icon-animated>svg path {
    opacity: 1;
}
/* .footer-accordion > summary::after {
  content: "";
  width: 15px;
  height: 9px;
  flex-shrink: 0;
  background-image: url("https://cdn.shopify.com/s/files/1/0914/3871/1083/files/Dropdown.png?v=1767169205");
  background-repeat: no-repeat;
  background-position: center;
  transition: transform 0.3s ease;
} */
  .footer-accordion > summary {
    cursor: pointer;
    list-style: none;
  }

  .footer-accordion > summary::-webkit-details-marker {
    display: none;
  }
  .footer-accordion__content {
    padding-bottom: 11px;
}
}

/* Desktop: always open */
@media (min-width: 750px) {
  .footer-accordion > summary {
    pointer-events: none;
  }
  .footer-accordion .menu__heading__toggle {
    display: none;
}
}

@media (max-width: 749px) {
  .footer-accordion > summary {
    cursor: pointer;
    list-style: none;
  }
  .footer-content{
    gap: 0px !important;
  }
  .footer-column .menu__heading   {
    padding:20px 0px !important;
  }
 .menu__details[open] svg path {
    opacity: 1 !important;
}
    .footer details[open]>summary .icon-animated>svg{
fill: #FFF;
  }
.footer-content{
  padding-bottom: 0px;
}
  .footer-accordion > summary::-webkit-details-marker {
    display: none;
  }
}

@media (min-width: 750px) {
  .footer-accordion > summary {
    pointer-events: none;
  }
}

