<script>
document.addEventListener('DOMContentLoaded', () => {
  const BREAKPOINT = 750;

  function initFooterAccordion() {
    document
      .querySelectorAll('.footer-block__details-content.heading')
      .forEach((summary) => {
        if (summary.closest('.footer-accordion')) return;

        const details = document.createElement('details');
        details.className = 'footer-accordion';

        summary.parentNode.insertBefore(details, summary);
        details.appendChild(summary);

        const contentWrapper = document.createElement('div');
        contentWrapper.className = 'footer-accordion__content';

        let next = details.nextElementSibling;
        while (
          next &&
          next.classList.contains('footer-block__details-content') &&
          !next.classList.contains('heading')
        ) {
          const current = next;
          next = current.nextElementSibling;
          contentWrapper.appendChild(current);
        }

        details.appendChild(contentWrapper);

        summary.addEventListener('click', (e) => {
          if (window.innerWidth >= BREAKPOINT) return;

          e.preventDefault();

          const isOpen = details.hasAttribute('open');

          if (isOpen) {
            contentWrapper.style.height = `${contentWrapper.scrollHeight}px`;
            requestAnimationFrame(() => {
              contentWrapper.style.height = '0px';
            });

            setTimeout(() => {
              details.removeAttribute('open');
            }, 350);
          } else {
            details.setAttribute('open', '');
            contentWrapper.style.height = '0px';

            requestAnimationFrame(() => {
              contentWrapper.style.height = `${contentWrapper.scrollHeight}px`;
            });

            setTimeout(() => {
              contentWrapper.style.height = 'auto';
            }, 350);
          }
        });
      });

    document.querySelectorAll('.footer-accordion').forEach((details) => {
      const content = details.querySelector('.footer-accordion__content');

      if (window.innerWidth >= BREAKPOINT) {
        details.setAttribute('open', '');
        content.style.height = 'auto';
      } else if (!details.hasAttribute('open')) {
        content.style.height = '0px';
      }
    });
  }

  initFooterAccordion();
  window.addEventListener('resize', initFooterAccordion);
});

</script>