{% comment %}
  Blog Sidebar Block
{% endcomment %}

<div
  class="blog-sidebar-block"
  style="
    background-color: {{ block.settings.sidebar_bg }};
    border-radius: {{ block.settings.sidebar_radius }}px;
  "
>

  {%- comment -%}
  =========================
  1. RECENT BLOGS
  =========================
  {%- endcomment -%}
  {% if block.settings.show_recent_blogs %}
    <div
      class="sidebar-card sidebar-recent-blogs"
      style="
        background-color: {{ block.settings.recent_bg }};
        border-radius: {{ block.settings.recent_radius }}px;
      "
    >
      {% if block.settings.recent_title != blank %}
        <h3 class="recent-title">
          {{ block.settings.recent_title }}
        </h3>
      {% endif %}

      {% assign blog_handle = block.settings.blog_handle %}
      {% if blogs[blog_handle] %}
        {% for article in blogs[blog_handle].articles limit: 2 %}
          <div class="recent-blog-item">
            <a
                href="{{ article.url }}"
                class="blog-title"
                style="font-size: {{ block.settings.blog_meta_size }}px;"
              >
            {% if article.image %}
              <img
                src="{{ article.image | image_url }}"
                alt="{{ article.title }}"
                loading="lazy"
              >
            {% endif %}
        </a>
            <div class="recent-blog-content">
              {% if block.settings.show_blog_date %}
                <span
                  class="blog-date"
                  style="font-size: {{ block.settings.blog_meta_size }}px;"
                >
                  {{ article.published_at | date: "%B, %Y" }}
                </span>
              {% endif %}

              <a
                href="{{ article.url }}"
                class="blog-title"
                style="font-size: {{ block.settings.blog_meta_size }}px;"
              >
                {{ article.title }}
              </a>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  {% endif %}

  {%- comment -%}
  =========================
  2. COMBO CARD
  =========================
  {%- endcomment -%}
{% if block.settings.show_combo %}
  {% assign combo_collection = collections[block.settings.combo_collection] %}
  {% assign combo_image = block.settings.combo_image %}

  {% if combo_collection %}
    <a
      href="{{ combo_collection.url }}"
      class="sidebar-combo-link"
      aria-label="{{ combo_collection.title }}"
    >
  {% endif %}

  <div
    class="sidebar-card sidebar-combo"
    style="
      background-color: {{ block.settings.combo_bg }};
      border-radius: {{ block.settings.combo_radius }}px;
    "
  >
    {% if combo_image %}
      <img
        src="{{ combo_image | image_url: width: 500 }}"
        alt="{{ block.settings.combo_title | escape }}"
      >
    {% elsif combo_collection and combo_collection.image %}
      <img
        src="{{ combo_collection.image | image_url: width: 500 }}"
        alt="{{ combo_collection.title | escape }}"
      >
    {% endif %}

    <div class="combo-content">
      {% if block.settings.combo_title != blank %}
        <h3>
          {{ block.settings.combo_title }}
        </h3>
      {% endif %}

      {% if block.settings.combo_subtitle != blank %}
        <p style="font-size: {{ block.settings.combo_subtitle_size }}px;">
          {{ block.settings.combo_subtitle }}
        </p>
      {% endif %}
    </div>
  </div>

  {% if combo_collection %}
    </a>
  {% endif %}
{% endif %}


  {%- comment -%}
  =========================
  3. MOST POPULAR
  =========================
  {%- endcomment -%}
    <!-- will implement later -->
    {% if block.settings.show_popular %}
  
  {% render 'freuqntly-buy-blog' %}
{% endif %}


  {%- comment -%}
  =========================
  4. FOLLOW US
  =========================
  {%- endcomment -%}
  {% if block.settings.show_follow_us %}
    <div class="sidebar-card sidebar-follow">
      <h3 class="blog-follow-us-title">{{ block.settings.follow_us_title }}</h3>
      <div
  class="social-icons__wrapper footer-utilities__icons"
  {{ block.shopify_attributes }}
>
  {% liquid
    assign social_links = 'facebook_url,instagram_url,youtube_url,tiktok_url,twitter_url,threads_url,linkedin_url,bluesky_url,snapchat_url,pinterest_url,tumblr_url,vimeo_url,custom_url' | split: ','
  %}

  {% for link_key in social_links %}
    {% liquid
      assign link_url = block.settings[link_key]
      assign render_icon = true

      if link_url != blank
        # Map setting names to platform names for display and icon purposes
        case link_key
          when 'facebook_url'
            assign platform = 'facebook'
          when 'instagram_url'
            assign platform = 'instagram'
          when 'youtube_url'
            assign platform = 'youtube'
          when 'tiktok_url'
            assign platform = 'tiktok'
          when 'twitter_url'
            assign platform = 'twitter'
          when 'threads_url'
            assign platform = 'threads'
          when 'linkedin_url'
            assign platform = 'linkedin'
          when 'bluesky_url'
            assign platform = 'bluesky'
          when 'snapchat_url'
            assign platform = 'snapchat'
          when 'pinterest_url'
            assign platform = 'pinterest'
          when 'tumblr_url'
            assign platform = 'tumblr'
          when 'vimeo_url'
            assign platform = 'vimeo'
          when 'custom_url'
            # For custom URLs, extract domain from URL for platform identification
            assign platform = link_url | split: '//' | last | remove: 'www.' | split: '.' | first
            # Special handling for specific platforms
            case platform
              when 'x'
                assign platform = 'twitter'
              else
                assign render_icon = false
            endcase
        endcase

        # Check if URL has a profile path (more than just the domain)
        assign url_parts = link_url | split: '//' | last | split: '/'
        assign has_profile = false

        if url_parts.size > 1 and url_parts[1] != ''
          assign has_profile = true
        endif

        unless render_icon
          assign has_profile = true
        endunless
      endif
    %}

    {% comment %}
      Only render the social icon if:
      1. In editor mode (always show, but may be disabled)
      2. On storefront AND has a valid profile link
    {% endcomment %}
    {% if link_url != blank %}
      {% if request.design_mode or has_profile %}
        <div
          class="social-icons__icon-wrapper{% unless has_profile %} social-icons__icon-wrapper--disabled{% endunless %}"
        >
          <a
            href="{{ link_url }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="{{ platform | capitalize }}"
            {% unless has_profile %}
              {% if request.design_mode %}
                onclick="return false;"
                aria-disabled="true"
              {% endif %}
            {% endunless %}
          >
            <span class="social-icons__icon-label">{{ platform | capitalize }}</span>
            {% if render_icon %}
             {%- render 'icon', icon: platform -%}

            {% endif %}
          </a>
        </div>
      {% endif %}
    {% endif %}
  {% endfor %}
</div>
    </div>
  {% endif %}

  {%- comment -%}
  =========================
  5. FEATURED PRODUCT
  =========================
  {%- endcomment -%}
  {% if block.settings.show_featured_product %}
    <div class="sidebar-card sidebar-featured">
      <!-- featured product later -->
    </div>
  {% endif %}
</div>
<style>
    /* ===============================
  BLOG SIDEBAR WRAPPER
================================ */
.blog-sidebar-block {
  display: flex;
  flex-direction: column;
  gap: 30px;
  max-width:527px;
  width:100%;
}

/* ===============================
  RECENT BLOGS
================================ */

.recent-blog-item {
  display: flex;
  gap: 10px;
  margin-bottom: 30px;
  align-items:center;
}

.recent-blog-item:last-child {
  margin-bottom: 0;
}

.recent-blog-item img {
  width: 114px;
  height: 109px;
  border-radius: 10px;
  object-fit: cover;
}

.recent-blog-content {
  display: flex;
  flex-direction: column;
  gap: 5px;
}


/* ===============================
  COMBO CARD
================================ */
.sidebar-combo {
  position: relative;
  padding: 0;
  overflow: hidden;
}

.sidebar-combo img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: inherit;
}
.combo-content {
position: absolute;
z-index: 2;
top: 50%;
left: 50%;
transform: translate(-50%, -50%);
}


/* ===============================
  MOST POPULAR (PLACEHOLDER)
================================ */
.sidebar-popular {
  background: #ffffff;
}
.sidebar-card.sidebar-recent-blogs{
padding:20px;
}
/* ===============================
  FOLLOW US
================================ */
.blog-sidebar-block .social-icons__icon-wrapper a{
border:1px solid {{ block.settings.follow_us_icon_color }};
}
.blog-sidebar-block .social-icons__icon-wrapper a svg path{
fill:{{ block.settings.follow_us_icon_color }};
}
.blog-sidebar-block .blog-follow-us-title{
color:{{ block.settings.follow_us_color }};
font-family: 'DM Sans';
font-weight: 700;
font-size: 24px;
line-height: 28.8px;
letter-spacing: 0px;
margin-bottom:26px;
}
.blog-sidebar-block .social-icons__wrapper{
gap:10px !important;
justify-content:start;
}
.sidebar-popular {
  margin-top: 24px;
}

.sidebar-title {
  font-size: 20px;
  font-weight: 600;
  color: #663700;
  margin-bottom: 16px;
}
.blog-sidebar-block .social-icons__icon-wrapper{
height:100%;
}


/* Custom css */
.has-sidebar .blog-posts-container.columns-2{ height: fit-content; }
.has-sidebar .recent-blog-item a.blog-title{flex-shrink: 0;}
.blog-sidebar-block .recent-title{
font-size: {{ block.settings.recent_title_size }}px;
line-height:{{ block.settings.recent_title_lineheight }}px;
letter-spacing:{{ block.settings.recent_title_letter_spacing }}px;
color:{{ block.settings.recent_title_color }};
font-weight:{{ block.settings.recent_title_fw }};
margin-bottom:30px;
font-family: 'DM Sans';
}
.blog-sidebar-block .recent-blog-content .blog-date{
font-size: {{ block.settings.date_label_size }}px;
line-height:{{ block.settings.date_label_lineheight }}px;
letter-spacing:{{ block.settings.date_label_letter_spacing }}px;
color:{{ block.settings.date_label_color }};
font-weight:{{ block.settings.date_label_fw }};
margin-bottom:0px;
font-family: 'DM Sans';
}
.blog-sidebar-block .recent-blog-content .blog-title{
font-size: {{ block.settings.blog_title_size }}px;
line-height:{{ block.settings.blog_title_lineheight }}px;
letter-spacing:{{ block.settings.blog_title_letter_spacing }}px;
color:{{ block.settings.blog_title_color }};
font-weight:{{ block.settings.blog_title_fw }};
margin-bottom:0px;
font-family: 'DM Sans';
text-decoration:none;
}
.blog-sidebar-block .combo-content{
 padding: 70px 16px;
 text-align: center;
 background:{{  block.settings.combo_card_content_bg }};
 opacity:{{ block.settings.bg_opacity }}%;
 max-width:286px;
 width:100%;
}
.blog-sidebar-block .combo-content h3{
font-size: {{ block.settings.combo_title_size }}px;
line-height:{{ block.settings.combo_title_lineheight }}px;
letter-spacing:{{ block.settings.combo_title_letter_spacing }}px;
color:{{ block.settings.combo_title_color }};
font-weight:{{ block.settings.combo_title_fw }};
margin-bottom:0px;
}
.blog-sidebar-block .combo-content p{
font-size: {{ block.settings.combo_subheading_size }}px;
line-height:{{ block.settings.combo_subheading_lineheight }}px;
letter-spacing:{{ block.settings.combo_subheading_letter_spacing }}px;
color:{{ block.settings.combo_subheading_color }};
font-weight:{{ block.settings.combo_subheading_fw }} !important;
margin-bottom:0px;
margin-top:10px;
}
@media (max-width:749px){
.blog-sidebar-block .recent-title{
font-size: {{ block.settings.recent_title_size_mobile }}px;
line-height:{{ block.settings.recent_title_lineheight_mobile }}px;
}
.blog-sidebar-block .recent-blog-content .blog-date{
font-size: {{ block.settings.date_label_size_mobile }}px;
line-height:{{ block.settings.date_label_lineheight_mobile }}px;
}
.blog-sidebar-block .recent-blog-content .blog-title{
font-size: {{ block.settings.blog_title_size_mobile }}px;
line-height:{{ block.settings.blog_title_lineheight_mobile }}px;
}
.blog-sidebar-block .combo-content h3{
font-size: {{ block.settings.combo_title_size_mobile }}px;
line-height:{{ block.settings.combo_title_lineheight_mobile }}px;
}
.blog-sidebar-block .combo-content p{
font-size: {{ block.settings.combo_subheading_size_mobile }}px !important;
line-height:{{ block.settings.combo_subheading_lineheight_mobile }}px !important;
}
}
@media (max-width:575px){
.recent-blog-item img {
  width: 80px;
  height: 76.50px;
}
.blog-sidebar-block .social-icons__wrapper{
margin:26px 0px 0px 0px;
}
}
@media (max-width:375px){
.blog-sidebar-block .combo-content{
max-width:200px;
width:100%;
padding: 40px 15px;
}
}
</style>
