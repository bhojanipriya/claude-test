{% style %}
.team-experts {
  background-color: {{ section.settings.bg_color }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  position: relative;
}

.team-experts__title {
  text-align: center;
  color: {{ section.settings.heading_color }};
  margin-bottom: 48px;
}

.team-experts__grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
  gap: 24px;
  position:relative;
      z-index: 1;
          max-width: 1780px;
    margin: 0 auto;
    padding: 0px 30px;
}

.team-card {
  text-align: center;
}

.team-card__image-wrapper {
  position: relative;
  overflow: hidden;
  border-radius: {{ section.settings.image_radius }}px;
}

.team-card__image-wrapper img {
  width: 100%;
  display: block;
}

.team-card__overlay {
  position: absolute;
  inset: 0;
  background-color: {{ section.settings.hover_overlay }};
  opacity: 0;
  transition: 0.3s ease;
}

.team-card__social {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 10px;
  opacity: 0;
  transition: 0.3s ease;
}

.team-card__social a {
  width: 34px;
  height: 34px;
  background: {{ section.settings.social_bg }};
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: 0.3s;
}

.team-card__social a:hover {
  background: {{ section.settings.social_bg_hover }};
}

.team-card__image-wrapper:hover .team-card__overlay {
  opacity: 0.3;
}
.team-card__image-wrapper:hover .team-card__social{opacity:1;}

.team-card__name {
  margin-top: 50px;
  color: {{ section.settings.name_color }};
    font-size: 24px;
    font-weight: 700;
    font-family: 'DM Sans';
    line-height: 28.8px;
        margin-bottom: 11px;
}

.team-card__position {
  color: {{ section.settings.position_color }};
  font-size: 16px;
}
section.team-experts:after {
    content: '';
    position: absolute;
    top: auto;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #f5eddc;
    z-index: 0;
    width: 100%;
    height: 50%;
}
@media(max-width:991px){
    /* .team-experts__grid {
        grid-template-columns: repeat(2, 1fr);
    } */
    .team-card__name {
        margin-top: 20px;
        font-size: 24px;
        margin-bottom: 11px;
    }
}
@media(max-width:749px){
    .team-experts {
    padding-top: 50px;
    padding-bottom: 50px;
    padding-left: 30px;
}

.team-experts__title {
  font-size: 36px;
  line-height: 39.2px;
  max-width: 368px;
  margin-bottom: 30px;
}
  .team-card__name {
        margin-top: 15px;
        font-size: 18px;
        margin-bottom: 5px;
    }
    .team-experts__grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 16px;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 10px;
  }

  .team-card {
    flex: 0 0 94.7%;
    scroll-snap-align: start;
  }

  /* Hide scrollbar */
  .team-experts__grid::-webkit-scrollbar {
    display: none;
  }
}

@media(max-width:575px){
    /* .team-experts__grid {
        grid-template-columns: repeat(1, 1fr);
    } */
}
{% endstyle %}

<section class="team-experts">
  {% if section.settings.heading != blank %}
    <h2 class="team-experts__title">
      {{ section.settings.heading }}
    </h2>
  {% endif %}

  <div class="team-experts__grid">
    {% for block in section.blocks %}
      <div class="team-card" {{ block.shopify_attributes }}>
        <div class="team-card__image-wrapper">
          {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 500 | image_tag }}
          {% endif %}

          <div class="team-card__overlay"></div>

          <div class="team-card__social">
            {% if block.settings.facebook != blank %}
              <a href="{{ block.settings.facebook }}" target="_blank">
                <svg xmlns="http://www.w3.org/2000/svg" width="9" height="16" viewBox="0 0 9 16" fill="none">
                    <path d="M8.33645 8.99057L8.79906 6.09798H5.9066V4.22088C5.9066 3.42953 6.31065 2.65815 7.6061 2.65815H8.92106V0.19542C8.92106 0.19542 7.72777 0 6.58686 0C4.20483 0 2.64782 1.38542 2.64782 3.89341V6.09798H0V8.99057H2.64782V15.9832H5.9066V8.99057H8.33645Z" fill="white"/>
                </svg>
              </a>
            {% endif %}
            {% if block.settings.instagram != blank %}
              <a href="{{ block.settings.instagram }}" target="_blank">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M7.9936 3.887C5.72721 3.887 3.89162 5.7226 3.89162 7.98899C3.89162 10.2554 5.72721 12.091 7.9936 12.091C10.26 12.091 12.0956 10.2554 12.0956 7.98899C12.0956 5.7226 10.2569 3.887 7.9936 3.887ZM7.9936 10.6518C6.52326 10.6518 5.33075 9.45934 5.33075 7.98899C5.33075 6.51864 6.52326 5.32613 7.9936 5.32613C9.46395 5.32613 10.6565 6.51864 10.6565 7.98899C10.6565 9.45934 9.46395 10.6518 7.9936 10.6518Z" fill="white"/>
                    <path d="M11.2871 0.0503451C9.81672 -0.0183335 6.17364 -0.0152117 4.70329 0.0503451C3.40776 0.109658 2.26832 0.424956 1.34741 1.34275C-0.188495 2.88178 0.0081753 4.9515 0.0081753 7.98897C0.0081753 11.0982 -0.163521 13.1211 1.34741 14.6352C2.88955 16.1773 4.99049 15.9744 7.99362 15.9744C11.0717 15.9744 12.1362 15.9775 13.2257 15.5561C14.7054 14.9817 15.823 13.6581 15.9322 11.2824C16.0009 9.81207 15.9978 6.16898 15.9322 4.69864C15.8011 1.89218 14.2933 0.187702 11.2871 0.0503451ZM13.6128 13.6175C12.6044 14.6258 11.2059 14.5353 7.97177 14.5353C4.64086 14.5353 3.30787 14.5852 2.33076 13.6081C1.21005 12.4905 1.41296 10.6987 1.41296 7.9796C1.41296 4.29905 1.03523 1.64868 4.72827 1.46138C5.57738 1.43016 5.82712 1.4208 7.9624 1.4208L7.99362 1.43953C11.5431 1.43953 14.3277 1.06804 14.4931 4.76107C14.5306 5.60395 14.5399 5.85681 14.5399 7.98897C14.5399 11.2793 14.6024 12.6217 13.6128 13.6175Z" fill="white"/>
                    <path d="M12.2579 4.68307C12.7872 4.68307 13.2163 4.25399 13.2163 3.72469C13.2163 3.19539 12.7872 2.76631 12.2579 2.76631C11.7286 2.76631 11.2995 3.19539 11.2995 3.72469C11.2995 4.25399 11.7286 4.68307 12.2579 4.68307Z" fill="white"/>
                </svg>
              </a>
            {% endif %}
            {% if block.settings.twitter != blank %}
              <a href="{{ block.settings.twitter }}" target="_blank">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="16" viewBox="0 0 18 16" fill="none">
<path d="M5.59413 0H0L6.60107 8.80196L0.359623 15.9832H2.4774L7.58244 10.1102L11.9874 15.9832H17.5816L10.7024 6.81045L16.6226 0H14.5048L9.721 5.50302L5.59413 0ZM12.7866 14.3849L3.19665 1.59832H4.79497L14.3849 14.3849H12.7866Z" fill="white"/>
</svg>
              </a>
            {% endif %}
            {% comment %} {% if block.settings.linkedin != blank %}
              <a href="{{ block.settings.linkedin }}" target="_blank">in</a>
            {% endif %}  {% endcomment %}
          </div>
        </div>

        <div class="team-card__name">
          {{ block.settings.name }}
        </div>
        <div class="team-card__position">
          {{ block.settings.position }}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Team of Experts",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section Title", "default": "Team of Skin Care Experts" },
    { "type": "color", "id": "heading_color", "label": "Section Title Color", "default": "#663700" },
    { "type": "color", "id": "bg_color", "label": "Section Background Color", "default": "#F5EDDC" },

    { "type": "color", "id": "name_color", "label": "Team Member Name Color", "default": "#663700" },
    { "type": "color", "id": "position_color", "label": "Position Color", "default": "#4A4A4A" },

    { "type": "color", "id": "hover_overlay", "label": "On Hover Image Overlay Color", "default": "#F5EDDC" },

    { "type": "range", "id": "image_radius", "label": "Image Corner Radius", "min": 0, "max": 40, "step": 1, "default": 10 },

    { "type": "color", "id": "social_bg", "label": "Social Background Color", "default": "#663700" },
    { "type": "color", "id": "social_bg_hover", "label": "Social Hover Background Color", "default": "#B46100" },

    { "type": "range", "id": "columns_desktop", "label": "Number of columns on desktop", "min": 2, "max": 6, "step": 1, "default": 4 },

    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "default": 100 }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team Member",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Dr. Dianne Russell" },
        { "type": "text", "id": "position", "label": "Position", "default": "Dermatologist" },

        { "type": "url", "id": "facebook", "label": "Facebook URL" },
        { "type": "url", "id": "instagram", "label": "Instagram URL" },
        { "type": "url", "id": "twitter", "label": "Twitter URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team of Experts",
      "blocks": [
        { "type": "member" },
        { "type": "member" },
        { "type": "member" },
        { "type": "member" }
      ]
    }
  ]
}
{% endschema %}


