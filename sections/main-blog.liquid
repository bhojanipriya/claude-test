  "options": [
    { "value": "grid", "label": "Grid only" },
    { "value": "sidebar", "label": "With sidebar" }
  ],
  "visible_if": "{{ section.settings.layout_type == 'column' }}"
},
{
  "type": "select",
  "id": "sidebar_position",
  "label": "Sidebar position",
  "default": "right",
  "info": "All sidebar settings are available in the block below (i.e., Blog Sidebar).",
  "options": [
    { "value": "left", "label": "Left sidebar" },
    { "value": "right", "label": "Right sidebar" }
  ],
