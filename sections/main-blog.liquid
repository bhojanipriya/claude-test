<style>
  .pagination-wrapper {
  margin-top: 0rem;
}
.pagination-wrapper nav.pagination {
    padding: 0;
    margin: 0;
}
@media screen and (min-width: 990px) {
  .pagination-wrapper {
    margin-top: 50px;
  }
}

.pagination__list {
  display: flex;
  flex-wrap: nowrap;
  justify-content: center;
}

.pagination__list > li {
  flex: 1 0 4.5rem;
  max-width: 45px;
  height: 45px;
}

.pagination__list > li:not(:last-child) {
  margin-right: -1px;
}
.paginate_item_opacity{
  pointer-events: none;
}
.paginate_item_opacity svg{
  opacity: 0.4;
}
.pagination__list li:first-child  {
  border-radius: 5px 0px 0px 5px;
}
.pagination__list li:last-child{
  border-radius: 0px 5px 5px 0px;
}
ul.pagination__list li {
  color: rgb(var(--color-foreground));
  display: inline-flex;
  justify-content: center;
  align-items: center;
  position: relative;
  width: 100%;
  height: 45px;
  padding: 0;
  text-decoration: none;
  border: 0.82px solid var(--Color-2, rgba(180, 97, 0, 0.40));
  background: var(--Color-1, #FFF);
  color: #663700;
font-family: "DM Sans";
font-size: 16px;
font-style: normal;
font-weight: 500;
line-height: 25.6px;
}
ul.pagination__list li.active {
  border: 0.82px solid var(--Color-2, rgba(180, 97, 0, 0.40));
  background: var(--Primary-Color, #663700);
  color: #fff;
  opacity: 1;
}
ul.pagination__list li a{
font-family: "DM Sans";
font-size: 16px;
font-style: normal;
font-weight: 500;
line-height: 25.6px;
padding: 12px 19px;
}
ul.pagination__list li:last-child a,ul.pagination__list li:first-child a {
    padding: 17px 19px;
}
.pagination__item--next .icon {
  margin-left: -0.2rem;
  transform: rotate(90deg);
}

.pagination__item--next:hover .icon {
  transform: rotate(90deg) scale(1.07);
}

.pagination__item--prev .icon {
  margin-right: -0.2rem;
  transform: rotate(-90deg);
}

.pagination__item--prev:hover .icon {
  transform: rotate(-90deg) scale(1.07);
}

.pagination__item-arrow:hover::after {
  display: none;
}
@media(max-width:989px){
 .pagination-wrapper {
    margin-top: 30px;
  }
}
</style>