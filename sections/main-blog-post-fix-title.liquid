

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section color-{{ section.settings.color_scheme }}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {%- if article.image -%}
      {%- content_for 'block', id: 'blog-post-image', type: '_blog-post-featured-image' %}
    {%- endif -%}
      <div class="blog-post-main-wrapper classicEditorial">
          <div class="blog-post-left">
            <div class="fixtitle-main">
            <div class="fixtitle-left">
                {%- content_for 'block', id: 'blog-post-details', type: '_blog-post-info-text' %}   
                {%- content_for 'block', id: 'blog-post-title', type: 'text' %}   
            </div>
            <div class="fixtitle-right">
                {%- content_for 'block', id: 'blog-post-content', type: '_blog-post-content' %}
            </div>
            </div>
            
            <div class="tags_social-media">
              {% if article.tags.size > 0 %}
                  <div class="article-tags">
                    <h4 class="tags-label">Tags :</h4>

                    <ul class="tags-list">
                      {% for tag in article.tags %}
                        <li class="tag-item">
                          <a href="{{ blog.url }}/tagged/{{ tag | handle }}">
                            {{ tag }}
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                  </div>
                {% endif %}
              <div class="social-media-area">
                  {% render 'share-icons', article: article %}
              </div>
            </div>
            <div class="blog-prev-next-nav">
    
                  {%- liquid
                    assign current_article_index = -1
                
                    for a in blog.articles
                      if a.id == article.id
                        assign current_article_index = forloop.index0
                        break
                      endif
                    endfor
                
                    assign prev_index = current_article_index | minus: 1
                    assign next_index = current_article_index | plus: 1
                
                    assign prev_article = blog.articles[prev_index]
                    assign next_article = blog.articles[next_index]
                
                    assign is_newest = false
                    if current_article_index == 0
                      assign is_newest = true
                    endif
                
                    assign last_index = blog.articles.size | minus: 1
                    assign is_oldest = false
                    if current_article_index == last_index
                      assign is_oldest = true
                    endif
                  -%}
                
                  {%- if is_newest == false and prev_article -%}
                    <a class="blog-nav-btn" href="{{ prev_article.url }}">
                 <svg class="read-prev-svg"xmlns="http://www.w3.org/2000/svg" width="7" height="12" viewBox="0 0 7 12" fill="none">
