{% liquid
  if section.settings.collection_list != blank
    assign section_collections = section.settings.collection_list
    assign max_items = section.settings.collection_list.count
  elsif section.settings.layout_type == 'editorial'
    assign max_items = section.settings.max_collections
  elsif section.settings.layout_type == 'bento'
    assign max_items = 4
  elsif section.settings.layout_type == 'carousel'
    assign max_items = section.settings.columns | plus: 2
  elsif section.settings.layout_type == 'grid'
    assign max_items = section.settings.columns
  elsif section.settings.layout_type == 'triset'
    assign max_items = 3
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-resource-list
    spacing-style
    gap-style
    {{ section.settings.custom_class }}
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  <div class="section-resource-list__content">
    {%- content_for 'blocks' -%}
  </div>

  {% if section_collections == null %}
    {% for i in (1..max_items) %}
      {% assign section_collections = section_collections | append: ', ' %}
    {% endfor %}
    {% assign section_collections = section_collections | split: ',' %}
  {% endif %}

  {% capture list_items %}
    {% for collection in section_collections limit: max_items %}
      <div class="resource-list__item">
        {% content_for 'block', type: '_collection-card', id: 'static-collection-card', closest.collection: collection %}
      </div>
      {% unless forloop.last %}
        <!--@list/split-->
      {% endunless %}
    {% endfor %}
  {% endcapture %}

  {% liquid
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% if section.settings.layout_type == 'triset' %}
    <div
      class="triset-layout triset-style--{{ section.settings.triset_style }}"
      style="gap: {{ section.settings.triset_gap }}px;"
    >
      <div class="triset-layout__item triset-layout__item--1">
        {{ list_items_array[0] }}
      </div>
      <div class="triset-layout__item triset-layout__item--2">
        {{ list_items_array[1] }}
      </div>
      <div class="triset-layout__item triset-layout__item--3">
        {{ list_items_array[2] }}
      </div>
    </div>

  {% else %}
    {% render 'resource-list',
      list_items: list_items,
      list_items_array: list_items_array,
      settings: section.settings,
      carousel_ref: 'collectionList',
      slide_count: max_items,
      content_type: 'collections',
      test_id: 'collections-list-grid'
    %}
  {% endif %}
</div>

<style>
/* ── Triset Layout ── */
.triset-layout {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  align-items: end;
  width: 100%;
}

.triset-layout .resource-list__item {
  overflow: hidden;
  height: 100%;
}

/* Items 1 & 3 — full height */
.triset-layout__item--1,
.triset-layout__item--3 {
  align-self: stretch;
}

.triset-layout__item--1 .resource-list__item,
.triset-layout__item--3 .resource-list__item {
  height: 100%;
}

.triset-layout__item--1 img,
.triset-layout__item--3 img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Item 2 — offset style: shorter, sits at bottom */
.triset-style--offset .triset-layout__item--2 {
  align-self: end;
  margin-top: {{ section.settings.triset_offset }}px;
}

/* Item 2 — even style: same height as others */
.triset-style--even .triset-layout__item--2 {
  align-self: stretch;
}

.triset-layout__item--2 img {
  width: 100%;
  display: block;
  object-fit: cover;
}

@media (max-width: 749px) {
  .triset-layout {
    grid-template-columns: 1fr;
    gap: 16px !important;
  }
  .triset-style--offset .triset-layout__item--2 {
    margin-top: 0;
  }
  .triset-layout__item--1,
  .triset-layout__item--2,
  .triset-layout__item--3 {
    align-self: auto;
  }
}

/* ── Existing collection card styles ── */
.resource-list .collection-card__inner {
  flex-direction: row;
  align-items: stretch;
}
.resource-list .collection-card__content {
  aspect-ratio: 1 / 0.916;
}
.resource-list .collection-card__content .button {
  display: flex;
  gap: 10px;
  margin-top: 20px;
  text-transform: capitalize;
  padding: 18.5px 32px;
}
.resource-list .collection-card__content .spacing-style.text-block.h4,
.resource-list .collection-card__content .spacing-style.text-block.h4 p {
  font-family: 'DM Sans' !important;
}
.resource-list .collection-card__content .spacing-style.text-block p {
  letter-spacing: 0;
}
.resource-list .collection-card__content .spacing-style.text-block {
  --max-width--body-narrow: 38ch !important;
}
.resource-list--grid .resource-list__item.odd_collection .collection-card__inner {
  flex-direction: row-reverse;
}
.resource-list--grid .collection-card__image,
.resource-list--grid .collection-card__content {
  align-items: stretch;
}
.resource-list--grid .collection-card__link {
  --ratio: 1 !important;
}
.resource-list--grid .collection-card__inner {
  --ratio: 1 / 0.916 !important;
}
main[data-template="list-collections"] .collection-card .collection-card__count {
  display: none;
}

@media (max-width: 989px) {
  body .collection-card { --ratio: 1 / 1.4 !important; }
  .resource-list .collection-card__content { aspect-ratio: 1 / 1.4; }
  .resource-list--grid .collection-card__inner { --ratio: 1 / 1.4 !important; }
  .resource-list .collection-card__content .button { margin-top: 10px; }
  .resource-list .collection-card__content .h2.spacing-style.text-block p {
    font-size: 32px !important;
    line-height: 38.4px;
    text-align: center;
  }
  .resource-list .collection-card__content .h4.spacing-style.text-block p {
    font-size: 18px;
    line-height: 21.6px;
    text-align: center;
  }
}

@media (max-width: 749px) {
  .resource-list .collection-card__inner {
    flex-direction: column !important;
    align-items: stretch;
    gap: 20px;
  }
  body .resource-list .collection-card { --ratio: 1 / 0.852 !important; }
  .resource-list .collection-card__content { aspect-ratio: unset !important; }
  .resource-list .collection-card__content .group-block { padding: 46px 20px; }
  .resource-list .collection-card__content .spacing-style.text-block.rte p {
    font-family: DM Sans;
    font-weight: 500;
    font-size: 14px;
    line-height: 22.4px;
    text-align: center;
  }
  .resource-list.resource-list--grid { padding: 0 14px; gap: 30px; }
  .resource-list--grid .collection-card__inner { --ratio: initial !important; }
  .resource-list .collection-card__content .spacing-style.text-block.h1 p {
    font-size: 32px !important;
    line-height: 38.4px !important;
  }
}
</style>

