<section class="mission_iwt_section">
    <div class="page-width">
        {% if section.settings.section_title != blank  %}
            <h2 class="mobile_title title {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" style="color: {{ section.settings.section_title_color }};">{{ section.settings.section_title }}</h2>
        {% endif %}
        <div class="mission-image_text_wrapper {% if section.settings.image_position == 'right' %}image-reverse{% endif %} ">
                <div class="custom-image {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                  {% if section.settings.image != blank %}
                    <img src="{{ section.settings.image | img_url: 'master' }}" alt="Image" width="auto" height="auto">
                    {% else %}
                    {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </div>
            {% if section.settings.section_title != blank or section.settings.description != blank or section.settings.sub_description != blank %}
                    <div class="custom-content {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                        {% if section.settings.section_title != blank  %}
                        <h2 class="desktop_title" style="color: {{ section.settings.section_title_color }};">{{ section.settings.section_title }}</h2>
                        {% endif %}
                        {% if section.settings.description != blank %}
                            <div class="description">
                                <p style="color: {{ section.settings.description_color }};">{{ section.settings.description }}</p>
                            </div>
                        {% endif %}
                        {% if section.settings.sub_description != blank %}
                            <div class="sub_description {% if section.settings.show_sub_description %}sub_description--over-image{% endif %}" style="background-color: {{section.settings.sub_description_bg_color}};">
                                <p style="color: {{ section.settings.sub_description_color }};">{{ section.settings.sub_description }}</p>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
        </div>
  </div>
</section>
{% style  %}
.mission_iwt_section .page-width{
    max-width: 1528px;
    padding: 0 50px;
    margin: 0 auto;
}
.mission-image_text_wrapper .custom-image{
    border-radius: {{ section.settings.mobile_radius_left_right }}px {{ section.settings.mobile_radius_top_bottom }}px {{ section.settings.mobile_radius_left_right }}px {{ section.settings.mobile_radius_top_bottom }}px;
    overflow: hidden;
    line-height:0;
}
.mission-image_text_wrapper .sub_description {
    padding: 30px;
    border-radius: 30px;
    margin-top: 50px;
}
.mission-image_text_wrapper .sub_description p{margin:0;}
.mission-image_text_wrapper .description p {
    margin: 30px 0 0;
}
.section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
}
.mobile_title{display:block;margin-top:0;}

.mission-image_text_wrapper .desktop_title{display:none;}
.mission-image_text_wrapper .custom-image img{
    width: 100%;
    object-fit: cover;
}
.mission-image_text_wrapper .custom-image{
    max-height: 560px;
}
.mobile_title{display:none;}
    .mission-image_text_wrapper .desktop_title{display:block;}
@media(min-width:750px){
    .mission-image_text_wrapper{display:flex;align-items:flex-start;}
    .mission-image_text_wrapper.image-reverse {flex-direction: row-reverse;}
    .mission-image_text_wrapper .custom-content{width: 100%;max-width: 44.6%;}
    .mission-image_text_wrapper .custom-image {width: 100%;max-width: 55.4%;}
    .mission-image_text_wrapper .sub_description.sub_description--over-image {margin-right: -138px;margin-left:0px;position: relative;z-index: 1;}
    .mission-image_text_wrapper .custom-image{ border-radius: {{ section.settings.radius_left_right }}px {{ section.settings.radius_top_bottom }}px {{ section.settings.radius_left_right }}px {{ section.settings.radius_top_bottom }}px;}
}
@media(min-width:1240px){
  .mission-image_text_wrapper .sub_description.sub_description--over-image{
          margin-left: 41px;
        z-index: 1;
        max-width: 724px;
      }
}
@media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
}
@media screen and (min-width: 1440px) {
   .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
}
@media(max-width:1440px){
    .mission-image_text_wrapper{gap:20px;}
    .mission-image_text_wrapper .custom-image{ border-radius: {{ section.settings.radius_left_right |  divided_by: 2 }}px {{ section.settings.radius_top_bottom  |  divided_by: 2}}px {{ section.settings.radius_left_right |  divided_by: 2}}px {{ section.settings.radius_top_bottom |  divided_by: 2 }}px;}
    .mission_iwt_section{ padding-bottom: 0;}
}
@media(max-width:1199px){
    .mission-image_text_wrapper .sub_description.sub_description--over-image{}
    .mission-image_text_wrapper.image-reverse{  flex-direction: column; width: 100%;}
    .mission-image_text_wrapper .custom-image{ width: 50%; margin: 0 auto;} 
    .mission-image_text_wrapper .custom-content{ max-width: 100%;}
    .mission-image_text_wrapper .sub_description{ margin-top: 30px; }
    .mission-image_text_wrapper .sub_description.sub_description--over-image {margin-right: 0px;}
    .mobile_title{display:block;}
    .mission-image_text_wrapper .desktop_title{display:none;}
}
@media(max-width:989px){
    .mission-image_text_wrapper {flex-direction:column !important;gap:0;}
    .mission-image_text_wrapper .custom-content{max-width:100%;}
    .mission-image_text_wrapper .custom-image{max-width:100%;border-radius: {{ section.settings.mobile_radius_left_right }}px {{ section.settings.mobile_radius_top_bottom }}px {{ section.settings.mobile_radius_left_right }}px {{ section.settings.mobile_radius_top_bottom }}px;}
    .mission-image_text_wrapper .custom-image img{width:100%;}
    .mission_iwt_section{padding-bottom:0 !important;}
    .mission-image_text_wrapper .description p{margin-top:20px;}
    .mission-image_text_wrapper .sub_description{margin-top:20px;border-radius:10px;padding:20px;}
}
@media(max-width:749px){
    .mission_iwt_section .page-width{padding:0 30px;}
    .mission-image_text_wrapper .custom-image{ width: 100%;height: 100%;max-width: 368px;max-height: 259px;}
    .mission_iwt_section h2.mobile_title.title {
    margin-bottom: 30px;
}
}
{% endstyle %}
{% schema %}
    {
      "name": "Mission Section",
      "settings": [
        {
          "type": "text",
          "id": "section_title",
          "label": "Section Title",
          "default": "Our Story"
        },
        {
          "type": "color",
          "id": "section_title_color",
          "label": "Section Title Color",
          "default": "#000000"
        },
        {
          "type": "inline_richtext",
          "id": "description",
          "label": "Description",
          "default": "This is our description section. Tell your brand story here."
        },
        {
          "type": "color",
          "id": "description_color",
          "label": "Description Text Color",
          "default": "#333333"
        },
        {
            "type": "checkbox",
            "id": "show_sub_description",
            "label": "Show Sub Description Over The Image"
        },
        {
          "type": "inline_richtext",
          "id": "sub_description",
          "label": "Sub Description",
          "default": "Extra details or content can go here."
        },
        {
          "type": "color",
          "id": "sub_description_color",
          "label": "Sub Description Text Color",
          "default": "#555555"
        },
        {
          "type": "color",
          "id": "sub_description_bg_color",
          "label": "Sub Description Background Color",
          "default": "#f9f9f9"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
            "type": "range",
            "id": "radius_left_right",
            "min": 0,
            "max": 300,
            "step": 20,
            "default": 280,
            "label": "Image Radius Top-Left and Bottom-Right"
        },
        {
            "type": "range",
            "id": "radius_top_bottom",
            "min": 0,
            "max": 300,
            "step": 20,
            "default": 0,
            "label": "Image Radius Top-Right and Bottom-Left"
        },
        {
            "type": "header",
            "content":"Mobile Image Corner Radius"
        },
        {
            "type": "range",
            "id": "mobile_radius_left_right",
            "min": 0,
            "max": 140,
            "step": 2,
            "default": 112,
            "label": "Image Radius Top-Left and Bottom-Right"
        },
        {
            "type": "range",
            "id": "mobile_radius_top_bottom",
            "min": 0,
            "max": 140,
            "step": 2,
            "default": 6,
            "label": "Image Radius Top-Right and Bottom-Left"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image Position",
          "default": "right",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        },
      ],
      "presets": [
        {
          "name": "Mission Section",
          "category": "Custom"
        }
      ]
    }
    {% endschema %}