.homepage-banner-1 .homebanner1-thirdimg .image-block:before {
    content: '';
    width: 442.612px;
    height: 556.149px;
    transform: rotate(4.713deg);
    border-radius: 10px;
    opacity: 0.3;
    background: rgba(180, 97, 0, 0.40);
    display: block;
    right: -15.47px;
    position: absolute;
    z-index: -1;
}

.homepage-banner-1 .homebanner1-thirdimg .image-block:after { 
    content: "";
    position: absolute;
    background-image: url(https://cdn.shopify.com/s/files/1/0914/3871/1083/files/banner-image-dot.png?v=1734934871);
    width: 141px;
    height: 114px;
    opacity: 1 !important;
    background-color: transparent;
    z-index: -1;
    top: auto;
    right: -104px;
    bottom: -35px;
}
{% if section.settings.section_right_decorative_image %}
.section-right_decorative:before,.section-left_decorative:after {
    content: '';
    position: absolute;
    top:-90px;
    right:0px;
    background-image: url({{ section.settings.section_right_decorative_image | img_url: 'master' }});
    background-repeat: no-repeat;
    background-size: cover;
    width: 214px;
    height: 215px;
    z-index: 0;
}
{% endif %}
{% if section.settings.section_left_decorative_image %}
.section-left_decorative:after {
    content: '';
    position: absolute;
    top: 30px;
    left: 0;
    background-image: url({{ section.settings.section_left_decorative_image | img_url: 'master' }});
    background-repeat: no-repeat;
    background-size: cover;
    width: 214px;
    height: 215px;
    z-index: 0;
}
{% endif %}
