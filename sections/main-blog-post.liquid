

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section color-{{ section.settings.color_scheme }}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {%- if article.image -%}
      {%- content_for 'block', id: 'blog-post-image', type: '_blog-post-featured-image' %}
    {%- endif -%}
      <div class="blog-post-main-wrapper">
          <div class="blog-post-left">
            {%- content_for 'block', id: 'blog-post-details', type: '_blog-post-info-text' %}   
            {%- content_for 'block', id: 'blog-post-title', type: 'text' %}   
            {%- content_for 'block', id: 'blog-post-content', type: '_blog-post-content' %}
            <div class="blog-prev-next-nav">
    
                  {%- liquid
                    assign current_article_index = -1
                
                    for a in blog.articles
                      if a.id == article.id
                        assign current_article_index = forloop.index0
                        break
                      endif
                    endfor
                
                    assign prev_index = current_article_index | minus: 1
                    assign next_index = current_article_index | plus: 1
                
                    assign prev_article = blog.articles[prev_index]
                    assign next_article = blog.articles[next_index]
                
                    assign is_newest = false
                    if current_article_index == 0
                      assign is_newest = true
                    endif
                
                    assign last_index = blog.articles.size | minus: 1
                    assign is_oldest = false
                    if current_article_index == last_index
                      assign is_oldest = true
                    endif
                  -%}
                
                  {%- if is_newest == false and prev_article -%}
                    <a class="blog-nav-btn" href="{{ prev_article.url }}">
                 <svg class="read-prev-svg"xmlns="http://www.w3.org/2000/svg" width="7" height="12" viewBox="0 0 7 12" fill="none">
                    <path d="M2.02229 5.98977C3.41901 7.42921 4.7829 8.83316 6.14523 10.2387C6.26837 10.3585 6.38379 10.4864 6.49071 10.6218C6.61417 10.7843 6.67627 10.9875 6.66546 11.1937C6.65465 11.3998 6.57167 11.595 6.43193 11.7428C6.2922 11.8906 6.10521 11.981 5.90571 11.9973C5.70621 12.0136 5.50775 11.9547 5.34722 11.8314C5.25411 11.7583 5.16707 11.6774 5.08696 11.5895C3.53001 9.98363 1.97409 8.37754 0.419233 6.77118C-0.141955 6.19218 -0.139604 5.78011 0.425492 5.19627C1.99911 3.57002 3.57377 1.94511 5.14947 0.321552C5.47852 -0.0171385 5.83494 -0.0881017 6.17416 0.107855C6.49852 0.294941 6.69001 0.596536 6.60716 0.973933C6.54168 1.21621 6.41519 1.43628 6.24058 1.6118C4.95251 2.96172 3.64958 4.29713 2.35213 5.63737C2.25208 5.73817 2.15595 5.84543 2.02229 5.98977Z" fill="#663700"/>
                </svg>
                <span class="ml-10">Previous</span>
              </a>
                  {%- else -%}
                    <span class="blog-nav-btn disabled" aria-disabled="true" style="opacity:0.4; pointer-events:none;">
                
                <svg class="read-prev-svg"xmlns="http://www.w3.org/2000/svg" width="7" height="12" viewBox="0 0 7 12" fill="none">
                    <path d="M2.02229 5.98977C3.41901 7.42921 4.7829 8.83316 6.14523 10.2387C6.26837 10.3585 6.38379 10.4864 6.49071 10.6218C6.61417 10.7843 6.67627 10.9875 6.66546 11.1937C6.65465 11.3998 6.57167 11.595 6.43193 11.7428C6.2922 11.8906 6.10521 11.981 5.90571 11.9973C5.70621 12.0136 5.50775 11.9547 5.34722 11.8314C5.25411 11.7583 5.16707 11.6774 5.08696 11.5895C3.53001 9.98363 1.97409 8.37754 0.419233 6.77118C-0.141955 6.19218 -0.139604 5.78011 0.425492 5.19627C1.99911 3.57002 3.57377 1.94511 5.14947 0.321552C5.47852 -0.0171385 5.83494 -0.0881017 6.17416 0.107855C6.49852 0.294941 6.69001 0.596536 6.60716 0.973933C6.54168 1.21621 6.41519 1.43628 6.24058 1.6118C4.95251 2.96172 3.64958 4.29713 2.35213 5.63737C2.25208 5.73817 2.15595 5.84543 2.02229 5.98977Z" fill="#663700"/>
                </svg>
                <span class="ml-10">Previous</span></span>
                  {%- endif -%}
                
                  {%- if is_oldest == false and next_article -%}
                    <a class="blog-nav-btn" href="{{ next_article.url }}"><span class="mr-10">Next</span> <svg xmlns="http://www.w3.org/2000/svg" width="7" height="12" viewBox="0 0 7 12" fill="none">
                        <path d="M4.66934 5.98977C3.26469 7.42921 1.89305 8.83316 0.522982 10.2387C0.399134 10.3585 0.283062 10.4864 0.175539 10.6218C0.0513706 10.7843 -0.011076 10.9875 -0.000206947 11.1937C0.0106621 11.3998 0.0941181 11.595 0.234645 11.7428C0.375173 11.8906 0.563223 11.981 0.76386 11.9973C0.964496 12.0136 1.16408 11.9547 1.32553 11.8314C1.41916 11.7583 1.5067 11.6774 1.58726 11.5895C3.15305 9.98363 4.71781 8.37754 6.28151 6.77118C6.84589 6.19218 6.84352 5.78011 6.27522 5.19627C4.69266 3.57002 3.10905 1.94511 1.5244 0.321552C1.19347 -0.0171385 0.83503 -0.0881017 0.493889 0.107855C0.167682 0.294941 -0.0249004 0.596536 0.0584197 0.973933C0.124276 1.21621 0.251482 1.43628 0.427087 1.6118C1.72248 2.96172 3.03281 4.29713 4.33764 5.63737C4.43825 5.73817 4.53493 5.84543 4.66934 5.98977Z" fill="#663700"/>
                        </svg>
                </a>
                  {%- else -%}
                    <span class="blog-nav-btn disabled" aria-disabled="true" style="opacity:0.4; pointer-events:none;"><span class="mr-10">Next</span> <svg xmlns="http://www.w3.org/2000/svg" width="7" height="12" viewBox="0 0 7 12" fill="none">
                        <path d="M4.66934 5.98977C3.26469 7.42921 1.89305 8.83316 0.522982 10.2387C0.399134 10.3585 0.283062 10.4864 0.175539 10.6218C0.0513706 10.7843 -0.011076 10.9875 -0.000206947 11.1937C0.0106621 11.3998 0.0941181 11.595 0.234645 11.7428C0.375173 11.8906 0.563223 11.981 0.76386 11.9973C0.964496 12.0136 1.16408 11.9547 1.32553 11.8314C1.41916 11.7583 1.5067 11.6774 1.58726 11.5895C3.15305 9.98363 4.71781 8.37754 6.28151 6.77118C6.84589 6.19218 6.84352 5.78011 6.27522 5.19627C4.69266 3.57002 3.10905 1.94511 1.5244 0.321552C1.19347 -0.0171385 0.83503 -0.0881017 0.493889 0.107855C0.167682 0.294941 -0.0249004 0.596536 0.0584197 0.973933C0.124276 1.21621 0.251482 1.43628 0.427087 1.6118C1.72248 2.96172 3.03281 4.29713 4.33764 5.63737C4.43825 5.73817 4.53493 5.84543 4.66934 5.98977Z" fill="#663700"/>
                        </svg>
                    </span>
                  {%- endif -%}
                
            </div>
          </div>
          <div class="blog-post-right">
          <div class="blog-sidebar-">
            <div class="blog-search-box-desktop">
                <form action="{{ routes.search_url }}" method="get" class="blog-search-form" role="search">
                  <input type="hidden" name="type" value="article">
                  <input
                      type="text"
                      name="q"
                      class="blog-local-search blog-search-input"
                      placeholder="Search"
                      aria-label="Search blogs"
                      autocomplete="off"
                      required
                      >
                  {% comment %} <button type="submit" class="blog-search-btn" aria-label="Search">
                      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none">
                          <path opacity="0.5" d="M13.8333 15L8.58333 9.75C8.16667 10.0833 7.6875 10.3472 7.14583 10.5417C6.60417 10.7361 6.02778 10.8333 5.41667 10.8333C3.90278 10.8333 2.62153 10.309 1.57292 9.26042C0.524306 8.21181 0 6.93056 0 5.41667C0 3.90278 0.524306 2.62153 1.57292 1.57292C2.62153 0.524306 3.90278 0 5.41667 0C6.93056 0 8.21181 0.524306 9.26042 1.57292C10.309 2.62153 10.8333 3.90278 10.8333 5.41667C10.8333 6.02778 10.7361 6.60417 10.5417 7.14583C10.3472 7.6875 10.0833 8.16667 9.75 8.58333L15 13.8333L13.8333 15ZM5.41667 9.16667C6.45833 9.16667 7.34375 8.80208 8.07292 8.07292C8.80208 7.34375 9.16667 6.45833 9.16667 5.41667C9.16667 4.375 8.80208 3.48958 8.07292 2.76042C7.34375 2.03125 6.45833 1.66667 5.41667 1.66667C4.375 1.66667 3.48958 2.03125 2.76042 2.76042C2.03125 3.48958 1.66667 4.375 1.66667 5.41667C1.66667 6.45833 2.03125 7.34375 2.76042 8.07292C3.48958 8.80208 4.375 9.16667 5.41667 9.16667Z" fill="#4A4A4A"/>
                      </svg>
                  </button> {% endcomment %}
                </form>
                <div class="blog-search-results"></div>
            </div>
          </div>
          <div class="read-nxt-desktop">
          <div class="blog-read-next">
            {%- liquid
              assign current_article_index = -1

              for a in blog.articles
                if a.id == article.id
                  assign current_article_index = forloop.index0
                  break
                endif
              endfor

              assign last_index = blog.articles.size | minus: 1
              assign is_oldest = false
              if current_article_index == last_index
                assign is_oldest = true
              endif

              if is_oldest
                assign prev_index_1 = current_article_index | minus: 1
                assign prev_index_2 = current_article_index | minus: 2
                assign prev_index_3 = current_article_index | minus: 3

                assign article_1 = blog.articles[prev_index_1]
                assign article_2 = blog.articles[prev_index_2]
                assign article_3 = blog.articles[prev_index_3]
              else
                assign next_index_1 = current_article_index | plus: 1
                assign next_index_2 = current_article_index | plus: 2
                assign next_index_3 = current_article_index | plus: 3

                assign article_1 = blog.articles[next_index_1]
                assign article_2 = blog.articles[next_index_2]
                assign article_3 = blog.articles[next_index_3]
              endif
            -%}

            {%- if article_1 or article_2 or article_3 -%}
              <h3 class="Read-next-title">
                {%- if is_oldest -%}
                  Read Previous
                {%- else -%}
                  Read Next
                {%- endif -%}
              </h3>

              <ul>
                {%- if article_1 != blank -%}
                  <li>
                    <a href="{{ article_1.url }}" class="read-next-link">
                      <div class="read-next-image-wrap">
                        {%- if article_1.image -%}
                          <img src="{{ article_1.image | image_url }}" alt="{{ article_1.image.alt | escape }}" loading="lazy" height="" width="">
                        {%- endif -%}
                      </div>
                      <p class="read-next-title">
                        <span>{{ article_1.created_at | date: "%d %B, %Y" }}</span>
                        {{ article_1.title }}
                      </p>
                      
                    </a>
                  </li>
                {%- endif -%}

                {%- if article_2 != blank -%}
                  <li>
                    <a href="{{ article_2.url }}" class="read-next-link">
                      <div class="read-next-image-wrap">
                        {%- if article_2.image -%}
                          <img src="{{ article_2.image | image_url }}" alt="{{ article_2.image.alt | escape }}" loading="lazy" height="" width="">
                        {%- endif -%}
                      </div>
                      <p class="read-next-title">
                      <span>{{ article_2.created_at | date: "%d %B, %Y" }}</span>
                        {{ article_2.title }}
                      </p>
                    </a>
                  </li>
                {%- endif -%}

                {%- if article_3 != blank -%}
                  <li>
                    <a href="{{ article_3.url }}" class="read-next-link">
                      <div class="read-next-image-wrap">
                        {%- if article_3.image -%}
                          <img src="{{ article_3.image | image_url }}" alt="{{ article_3.image.alt | escape }}" loading="lazy" height="" width="">
                        {%- endif -%}
                      </div>
                      <p class="read-next-title">
                        <span>{{ article_3.created_at | date: "%d %B, %Y" }}</span>
                        {{ article_3.title }}
                      </p>
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
        <div class="social-media-area">
          {% render 'share-icons', article: article %}
        </div>
      </div>
      </div>
    {% comment %} Dynamic area for @app blocks only, at the bottom {% endcomment %}
    {% content_for 'blocks' %}

    {% if blog.comments_enabled? %}
      <div class="blog-post-comments-container">
        <h2 class="h3 c-count">{{- 'blogs.article.comments_heading' | t: count: article.comments_count -}}</h2>

        <div class="blog-post-comments">
          {% paginate article.comments by 10 %}
            {% for comment in article.comments %}
              <div class="blog-post-comment">
                {{ comment.content }}
                <div class="blog-post-comment__author">
                  <span class="blog-post-comment__author-name">{{- comment.author -}}</span>
                  <span>{{- 'blogs.article.comment_author_separator' | t -}}</span>
                  <span class="blog-post-comment__date">
                    {{- comment.created_at | time_tag: format: 'date' -}}
                  </span>
                </div>
              </div>
            {% endfor %}

            <div class="blog-post-comments-pagination">
              {{- paginate | default_pagination -}}
            </div>
          {% endpaginate %}
        </div>

        {% render 'blog-comment-form', article: article, section_id: section.id %}
      </div>
    {% endif %}
  </div>
</div>

