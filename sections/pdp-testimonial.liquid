{% if product.metafields.custom.testimonials_section != blank %}
    <div class="testimonial-wrapper {% if section.settings.decorative_image != blank %} testimonial_decorative {% endif %}">
        <div class="page-width">
            <div class="testimonial-slider-pdp">
                <div class="quote">
