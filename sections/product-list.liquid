{% liquid
  assign max_items = section.settings.max_products
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  data-testid="product-list"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-resource-list
    spacing-style
    gap-style
    {% if section.settings.decorative_image != blank %} bestseller_decorative {% endif %}
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>

  {%- comment -%}
    ── Section Header row: Title (left) + View All button (right) ──
    Figma: flex row, justify-content: space-between, align-items: center
  {%- endcomment -%}
  <div class="product-list-header-row">
    <div class="section-resource-list__header">
      {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
    </div>

    {%- if section.settings.view_all_enable and section.settings.view_all_url != blank -%}
      <a
        href="{{ section.settings.view_all_url }}"
        class="product-list-view-all"
        {% if section.settings.view_all_new_tab %}target="_blank" rel="noopener"{% endif %}
      >
        {{- section.settings.view_all_text | default: 'View All' -}}
        <span class="product-list-view-all__icon" aria-hidden="true">
          {%- comment -%} Figma node I10684:8311;9337:10603 — 11×11 northeast arrow {%- endcomment -%}
          <svg width="11" height="11" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1.1168 10.3577L0 9.2409L7.6418 1.5991H0.7957V0H10.3577V9.562H8.7586V2.7028L1.1168 10.3577Z" fill="currentColor"/>
          </svg>
        </span>
      </a>
    {%- endif -%}
  </div>

  {% capture list_items %}
    {% if section.settings.collection != blank and shop.products_count != 0 %}
      {% paginate section.settings.collection.products by max_items %}
        {% for product in section.settings.collection.products limit: max_items %}
          {%- liquid
            assign _sale_end = product.metafields.custom.sale_end
            assign _show_timer = false
            if section.settings.show_countdown_timer and _sale_end != blank
              assign _show_timer = true
            endif
          -%}
          <div class="resource-list__item{% if _show_timer %} has-countdown{% endif %}">
            {% # theme-check-disable UniqueStaticBlockId %}
              {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product %}
            {% # theme-check-enable UniqueStaticBlockId %}
            {%- if _show_timer -%}
              <div
                class="pcd-overlay"
                data-end="{{ _sale_end | date: '%Y-%m-%dT%H:%M:%S' }}"
                aria-label="Sale countdown"
                role="timer"
              >
                <div class="pcd-overlay__inner">
                  <div class="pcd-overlay__block">
                    <div class="pcd-overlay__num">00</div>
                    <span class="pcd-overlay__label">Days</span>
                  </div>
                  <span class="pcd-overlay__sep" aria-hidden="true"></span>
                  <div class="pcd-overlay__block">
                    <div class="pcd-overlay__num">00</div>
                    <span class="pcd-overlay__label">Hours</span>
                  </div>
                  <span class="pcd-overlay__sep" aria-hidden="true"></span>
                  <div class="pcd-overlay__block">
                    <div class="pcd-overlay__num">00</div>
                    <span class="pcd-overlay__label">Mins</span>
                  </div>
                  <span class="pcd-overlay__sep" aria-hidden="true"></span>
                  <div class="pcd-overlay__block">
                    <div class="pcd-overlay__num">00</div>
                    <span class="pcd-overlay__label">Sec</span>
                  </div>
                </div>
              </div>
            {%- endif -%}
          </div>
          {% unless forloop.last %}<!--@list/split-->{% endunless %}
        {% endfor %}
      {% endpaginate %}
    {% else %}
      {% for i in (1..max_items) %}
        <div class="resource-list__item">
          {% # theme-check-disable UniqueStaticBlockId %}
            {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
          {% # theme-check-enable UniqueStaticBlockId %}
        </div>
        {% unless forloop.last %}<!--@list/split-->{% endunless %}
      {% endfor %}
    {% endif %}
  {% endcapture %}

  {% liquid
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {%- comment -%} Layout wrapper: show decorative image only when image is set AND show_decorative_image is true {%- endcomment -%}
  {% if section.settings.decorative_image != blank and section.settings.show_decorative_image %}
    <div class="bestseller-layout bestseller-layout--with-image">
      <div class="bestseller-image">
        <img
          src="{{ section.settings.decorative_image | img_url: 'master' }}"
          alt="{{ section.settings.decorative_image.alt | default: 'Decorative Image' }}"
          loading="lazy"
        >
      </div>
      <div class="bestseller-products">
        {% render 'resource-list',
          list_items: list_items,
          list_items_array: list_items_array,
          settings: section.settings,
          slide_count: max_items,
          content_type: 'products',
          test_id: 'resource-list-grid'
        %}
      </div>
    </div>
  {% else %}
    <div class="bestseller-layout bestseller-layout--no-image">
      <div class="bestseller-products">
        {% render 'resource-list',
          list_items: list_items,
          list_items_array: list_items_array,
          settings: section.settings,
          slide_count: max_items,
          content_type: 'products',
          test_id: 'resource-list-grid'
        %}
      </div>
    </div>
  {% endif %}

  <div
    class="section-resource-list__content"
    style="--horizontal-alignment: {{ section.settings.horizontal_alignment }};"
  >
    {%- content_for 'blocks' -%}
  </div>
</div>

{% if section.settings.btn_text != blank and section.settings.btn_url != blank %}
  <div class="dynamic-button-wrapper" style="display:flex; justify-content:{{ section.settings.btn_align }};">
    <a href="{{ section.settings.btn_url }}"
       class="dynamic-button"
       style="
         color: {{ section.settings.btn_color }};
         background-color: {{ section.settings.btn_bg }};
         border-radius: {{ section.settings.btn_radius }}px;
       ">
       {{ section.settings.btn_text }}
       <span class="btn-svg-bs" style="padding-left:10px;">
         <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
           <path d="M1.2184 11.3137L0 10.0953L8.35474 1.74057H0.870285V0H11.3137V10.4434H9.57314V2.95897L1.2184 11.3137Z" fill="white"/>
         </svg>
       </span>
    </a>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:names.product_list",
  "class": "ui-test-product-list",
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" },
    { "type": "_divider" }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Decorative Image"
    },
    {
      "type": "image_picker",
      "id": "decorative_image",
      "label": "Select Image"
    },
    {
      "type": "checkbox",
      "id": "show_decorative_image",
      "label": "Show Decorative Image",
      "default": true
    },
    {
      "type": "header",
      "content": "View All Button"
    },
    {
      "type": "checkbox",
      "id": "view_all_enable",
      "label": "Show \"View All\" Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "Button Label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "view_all_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Countdown Timer"
    },
    {
      "type": "checkbox",
      "id": "show_countdown_timer",
      "label": "Enable Countdown Timer",
      "info": "Automatically shows a countdown on any product that has the metafield custom.sale_end set.",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_type",
      "options": [
        { "value": "grid",      "label": "t:options.grid" },
        { "value": "carousel",  "label": "t:options.carousel" },
        { "value": "editorial", "label": "t:options.editorial" }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout_type != 'carousel' }}"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type != 'editorial' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        { "value": "1", "label": "t:options.one_number" },
        { "value": "2", "label": "t:options.two_number" }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.layout_type == 'grid' and section.settings.carousel_on_mobile == false }}"
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "t:settings.mobile_columns",
      "options": [
        { "value": "60cqw", "label": "t:options.one_number" },
        { "value": "44cqw", "label": "t:options.two_number" }
      ],
      "default": "60cqw",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0, "max": 100, "step": 1, "unit": "px", "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0, "max": 100, "step": 1, "unit": "px", "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        { "value": "arrow",        "label": "t:options.arrows" },
        { "value": "chevron",      "label": "t:options.chevrons" },
        { "value": "arrows_large", "label": "t:options.arrows_large" },
        { "value": "chevron_large","label": "t:options.chevron_large" },
        { "value": "none",         "label": "t:options.none" }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        { "value": "none",   "label": "t:options.none" },
        { "value": "circle", "label": "t:options.circle" },
        { "value": "square", "label": "t:options.square" }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' and section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "header",
      "content": "Button Settings"
    },
    { "id": "btn_text",   "type": "text",  "label": "Button Text" },
    { "id": "btn_url",    "type": "url",   "label": "Button Link" },
    { "id": "btn_color",  "type": "color", "label": "Button Text Color" },
    { "id": "btn_bg",     "type": "color", "label": "Button Background Color" },
    {
      "id": "btn_radius", "type": "range",
      "min": 0, "max": 50, "step": 1, "unit": "px",
      "label": "Button Radius", "default": 10
    },
    {
      "id": "btn_align", "type": "select", "label": "Button Alignment",
      "options": [
        { "label": "Left",   "value": "flex-start" },
        { "label": "Center", "value": "center" },
        { "label": "Right",  "value": "flex-end" }
      ]
    },
    {
      "type": "header",
      "content": "Slider Button Settings"
    },
    { "type": "number", "id": "slider_button_width",    "label": "Width (px)" },
    { "type": "number", "id": "slider_button_height",   "label": "Height (px)" },
    { "type": "number", "id": "slider_button_radius",   "label": "Border Radius (px)" },
    { "type": "color",  "id": "slider_button_bg_color", "label": "Background Color" },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        { "value": "flex-start", "label": "t:options.left" },
        { "value": "center",     "label": "t:options.center" },
        { "value": "flex-end",   "label": "t:options.right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0, "max": 100, "step": 1, "unit": "px", "default": 12
    },
    {
      "type": "color_scheme",
