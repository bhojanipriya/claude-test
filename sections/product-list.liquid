/* =============================================
   COUNTDOWN TIMER OVERLAY
   Pixel-perfect match: Figma node 11323:11312
   ============================================= */

/* Item must be relative for the pre-move state */
.ui-test-product-list .resource-list__item.has-countdown {
  position: relative;
}

/* JS moves .pcd-overlay inside .product-media-container and sets
   position:relative on that container so the overlay sticks to the
   bottom of the product image */
.pcd-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  width: 100%;
}

/* ── Band: rgba(240,240,240,0.5) · padding 20px · flex center · gap 20px ── */
.pcd-overlay__inner {
  display: flex;
  align-items: flex-start;   /* keep items top-aligned; separator uses margin-top to align with number box center */
  justify-content: center;
  gap: 20px;
  padding: 20px;
  background: rgba(240, 240, 240, 0.5);
  box-sizing: border-box;
  width: 100%;
}

/* ── Each column: number box + label ── */
.pcd-overlay__block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;                 /* gap between number box and label per Figma */
  flex-shrink: 0;
}

/* ── Number box: rgba(0,0,0,0.5) · 68×68px square · Roboto Bold 40/48 white ──
   68px = 10px padding + 48px line-height + 10px padding (square per Figma)   */
.pcd-overlay__num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68px;
  height: 68px;              /* explicit square — 10+48+10 = 68px */
  padding: 10px;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 0;          /* square, no rounding per Figma */
  font-family: "Roboto", sans-serif;
  font-weight: 700;
  font-size: 40px;
  line-height: 48px;
  text-align: center;
  color: #ffffff;
  box-sizing: border-box;
  flex-shrink: 0;
}

/* ── Label: Roboto Medium 18px · #434377 ── */
.pcd-overlay__label {
  font-family: "Roboto", sans-serif;
  font-weight: 500;
  font-size: 18px;
  line-height: 21.6px;
  text-align: center;
  color: #434377;
  white-space: nowrap;
  min-width: 100%;           /* min-w-full per Figma */
}

/* ── Separator: two white dots, 5×20px per Figma ──
   margin-top: 24px aligns the dot pair with the number box center:
   box center = 34px from content start (10px pad + 48/2)
   dot pair center at: margin-top(24) + height(20)/2 = 34px ✓             */
.pcd-overlay__sep {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  width: 5px;
  height: 20px;
  margin-top: 24px;          /* vertically center dots with number box text */
}

.pcd-overlay__sep::before,
.pcd-overlay__sep::after {
  content: '';
  display: block;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #ffffff;
  flex-shrink: 0;
}

/* ── Tablet (989px – 750px) ──
   Boxes scale to 52px: center at 8+18=26px → margin-top = 26-10 = 16px  */
@media screen and (max-width: 989px) and (min-width: 750px) {
  .pcd-overlay__inner  { gap: 14px; padding: 16px 12px; }
  .pcd-overlay__num    { width: 52px; height: 52px; font-size: 28px; line-height: 36px; padding: 8px; }
  .pcd-overlay__sep    { margin-top: 16px; }
  .pcd-overlay__label  { font-size: 14px; line-height: 18px; }
}

/* ── Mobile (< 750px) ──
   Boxes scale to 44px: center at 6+14=20px → margin-top = 20-10 = 10px  */
@media (max-width: 749px) {
  .pcd-overlay__inner  { gap: 8px; padding: 12px 8px; }
  .pcd-overlay__num    { width: 44px; height: 44px; font-size: 22px; line-height: 28px; padding: 6px; }
  .pcd-overlay__sep    { margin-top: 10px; width: 4px; height: 16px; }
  .pcd-overlay__sep::before,
  .pcd-overlay__sep::after { width: 4px; height: 4px; }
  .pcd-overlay__label  { font-size: 11px; line-height: 14px; }
}

/* ── Very small (< 400px) ──
   Boxes scale to 36px: center at 4+12=16px → margin-top = 16-8 = 8px    */
@media (max-width: 400px) {
  .pcd-overlay__inner  { gap: 5px; padding: 8px 4px; }
  .pcd-overlay__num    { width: 36px; height: 36px; font-size: 18px; line-height: 24px; padding: 4px; }
  .pcd-overlay__sep    { margin-top: 8px; width: 3px; height: 14px; }
  .pcd-overlay__sep::before,
  .pcd-overlay__sep::after { width: 3px; height: 3px; }
  .pcd-overlay__label  { font-size: 10px; line-height: 13px; }
}
