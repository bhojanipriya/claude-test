<script>
(function () {
  'use strict';

  function pad(n) { return ('0' + n).slice(-2); }

  function startTimer(overlay) {
    var endTime = new Date(overlay.getAttribute('data-end')).getTime();
    if (isNaN(endTime)) return;

    var nums = overlay.querySelectorAll('.pcd-overlay__num');
    if (nums.length < 4) return;

    function tick() {
      var diff = endTime - Date.now();
      if (diff <= 0) {
        overlay.style.display = 'none';
        clearInterval(iv);
        return;
      }
      nums[0].textContent = Math.floor(diff / 86400000);
      nums[1].textContent = pad(Math.floor((diff % 86400000) / 3600000));
      nums[2].textContent = pad(Math.floor((diff % 3600000)  / 60000));
      nums[3].textContent = pad(Math.floor((diff % 60000)    / 1000));
    }

    tick();
    var iv = setInterval(tick, 1000);
  }

  function mountCountdowns() {
    /* Find every countdown overlay rendered by product-list.liquid */
    document.querySelectorAll('.ui-test-product-list .pcd-overlay').forEach(function (overlay) {
      /* Skip if already mounted (re-init guard) */
      if (overlay.dataset.mounted) return;
      overlay.dataset.mounted = '1';

      /* Find the nearest resource-list__item ancestor */
      var item = overlay.parentElement;
      while (item && !item.classList.contains('resource-list__item')) {
        item = item.parentElement;
      }

      if (item) {
        /* Try known Horizon / Dawn media-container selectors */
        var media = item.querySelector(
          '.product-media-container, ' +
          '.product-card__image-wrapper, ' +
          '.card__media, ' +
          '.media-wrapper, ' +
          '[data-media-container], ' +
          'figure.product-media, ' +
          '.product__media-wrapper'
        );

        if (media) {
          /* Ensure the container creates a stacking context */
          var pos = window.getComputedStyle(media).position;
          if (!pos || pos === 'static') media.style.position = 'relative';
          media.appendChild(overlay);    /* Move overlay inside image container */
        }
      }

      /* Show the overlay (was hidden in HTML to avoid flash before JS runs) */
      overlay.style.display = '';
      startTimer(overlay);
    });
  }

  /* Initial mount */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mountCountdowns);
  } else {
    mountCountdowns();
  }

  /* Re-mount when theme editor reloads this section */
  document.addEventListener('shopify:section:load', function (evt) {
    if (evt.target && evt.target.querySelector('.ui-test-product-list')) {
      mountCountdowns();
    }
  });
})();
</script>
