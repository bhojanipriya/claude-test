

<script
  src="{{ 'marquee.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% assign gap_between_elements = section.settings.gap_between_elements %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<marquee-component
  class="section spacing-style gap-style color-{{ section.settings.color_scheme }}"
  style="
    {%- render 'spacing-style', settings: section.settings %};
    {% render 'gap-style', value: gap_between_elements, name: 'marquee-gap' %}
    --marquee-direction: {{ section.settings.movement_direction }};
    --marquee-text-color: {{ section.settings.text_color }};
    --marquee-letter-spacing: {{ section.settings.letter_spacing }}px;
    --marquee-font-size: {{ section.settings.font_size }}px;
    --marquee-border-top-width: {{ section.settings.border_top_width }}px;
    --marquee-border-bottom-width: {{ section.settings.border_bottom_width }}px;
    --marquee-border-color: {{ section.settings.border_color }};
    --marquee-border-style: {{ section.settings.border_style }};
    --marquee-text-transform: {{ section.settings.text_transform }};
    --marquee-font-weight: {{ section.settings.font_weight }};
    --marquee-margin-top: {{ section.settings.margin_top }}px;
    --marquee-margin-bottom: {{ section.settings.margin_bottom }}px;
  "
  data-speed-factor="25"
  data-movement-direction="{{ section.settings.movement_direction }}"
>
  <div
    class="marquee__wrapper"
    ref="wrapper"
  >
    <div
      class="marquee__content"
      ref="content"
    >
      <div
        class="marquee__repeated-items"
        ref="marqueeItems[]"
      >
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</marquee-component>

{% stylesheet %}
  marquee-component {
    display: block;
    width: 100%;
    overflow: hidden;
    border-top: var(--marquee-border-top-width) var(--marquee-border-style) var(--marquee-border-color);
    border-bottom: var(--marquee-border-bottom-width) var(--marquee-border-style) var(--marquee-border-color);
    margin-top: var(--marquee-margin-top);
    margin-bottom: var(--marquee-margin-bottom);
  }

  .marquee__wrapper {
    display: flex;
    gap: var(--marquee-gap);
    width: fit-content;
    white-space: nowrap;
  }

  .marquee__content {
    min-width: max-content;
    display: flex;
    gap: var(--marquee-gap);
  }

  .marquee__content .marquee__repeated-items * {
    max-width: none;
  }

  .marquee__repeated-items {
    min-width: max-content;
    display: flex;
    gap: var(--marquee-gap);
    align-items: center;
    justify-content: center;
  }

  .marquee__repeated-items > * {
    align-content: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    marquee-component:not([data-disabled]) .marquee__wrapper {
      animation: marquee-motion var(--marquee-speed) linear infinite var(--marquee-direction);
    }
  }

  @keyframes marquee-motion {
    to {
      transform: translate3d(calc(-50% - (var(--marquee-gap) / 2)), 0, 0);
    }
  }
  .marquee__content :is(p, h1, h2, h3, h4, h5, h6),
  .marquee__repeated-items :is(p, h1, h2, h3, h4, h5, h6),
  .marquee__repeated-items * {
    white-space: nowrap;
    color: var(--marquee-text-color) !important;
    letter-spacing: var(--marquee-letter-spacing) !important;
    font-size: var(--marquee-font-size) !important;
    text-transform: var(--marquee-text-transform) !important;
    font-weight: var(--marquee-font-weight) !important;
  }
  @media (max-width:991px){
    marquee-component{
      padding:50px 0;
    }
    .marquee__wrapper .marquee__repeated-items{
      gap: 30px !important;
    }
  }
{% endstylesheet %}


