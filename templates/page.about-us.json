    "our_mission_FHKpVm": {
      "type": "our-mission",
      "name": "Mission Section",
      "settings": {
        "section_title": "Our Mission",
        "section_title_color": "#663700",
        "description": "At Amari, our mission is to empower individuals to embrace their unique beauty with confidence. We are dedicated to crafting high-quality, innovative skincare, makeup, and haircare solutions that not only enhance your outer radiance but also nurture your skin and hair from within. Rooted in a commitment to excellence, safety, and the transformative power of nature, our products are meticulously formulated to cater to diverse beauty needs. With precision and care, we combine science and nature’s finest ingredients to redefine beauty and promote health, vitality, and timeless radiance.",
        "description_color": "#4a4a4a",
        "show_sub_description": true,
        "sub_description": "We envision a world where everyone feels confident and radiant in their own skin. By blending the best of nature and science, we aim to redefine beauty standards and inspire self-love. Our commitment to innovation and quality ensures that every product delivers visible results, empowering you to feel beautiful inside and out.",
        "sub_description_color": "#ffffff",
        "sub_description_bg_color": "#663700",
        "image": "shopify:\/\/shop_images\/ourmisson.webp",
