<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >
    {% comment %} {{ index.css | asset_url | stylesheet_tag }} {% endcomment %}
    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}
{% comment %} {% section 'product-list' %} {% endcomment %}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}
 {% if settings.purchase_code != blank %}
{% comment %} <link rel="stylesheet" href="https://rainbow-caramel-cee97c.netlify.app/.netlify/functions/protect-css?key={{ settings.purchase_code }}"> {% endcomment %}

{% endif %}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
      {% comment %} <script>
    document.addEventListener('DOMContentLoaded', function() {
        const currentCode = "{{ settings.purchase_code | escape }}";
        const lastCode = localStorage.getItem("validatedPurchaseCode");
         if (!currentCode) {
        showMessage(
          '⚠️ Theme license is not added!',
          '#ffdddd',
          '#990000'
        );
        return;
      }

      if (currentCode === lastCode) {
        console.log("🔁 Purchase code unchanged, skipping validation.");
        return;
      }

      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href =
        'https://deft-pavlova-f14eb6.netlify.app/.netlify/functions/protect-css?key=' +
        encodeURIComponent(currentCode);

      link.onload = function () {
        showMessage(
          '✅ Theme license key is valid!',
          '#d4edda',
          '#155724'
        );
        localStorage.setItem("validatedPurchaseCode", currentCode);
      };

      link.onerror = function () {
        showMessage(
          '❌ Invalid license key or domain not authorized.',
          '#f8d7da',
          '#721c24'
        );
        localStorage.removeItem("validatedPurchaseCode");
      };

      document.head.appendChild(link);

      function showMessage(text, bg, color) {
        const msg = document.createElement('div');
        msg.textContent = text;
        msg.style.cssText = `
          background:${bg};
          color:${color};
          padding:10px;
          text-align:center;
          font-weight:bold;
          position:fixed;
          top:0;
          left:0;
          width:100%;
          z-index:9999;
        `;
        document.body.prepend(msg);
        setTimeout(() => msg.remove(), 5000);
      }
    });
</script> {% endcomment %}
    {% endif %}
    {{ content_for_header }}
    <link
  rel="stylesheet"
  type="text/css"
  href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"
/>
{{ 'index.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script
      src="{{ 'critical.js' | asset_url }}"
      type="module"
      async
      blocking="render"
    ></script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
    <script src="{{ 'jquery.js' | asset_url }}"></script>
    <script src="{{ 'slick.min.js' | asset_url }}"></script>
    <script>
      $(document).ready(function () {
          function initExclusiveSlider() {
            const $slider = $('.exclusive_products-wrapper .group-block-content').first();


            if ($(window).width() <= 749) {
              if (!$slider.hasClass('slick-initialized')) {
                $slider.slick({
                  slidesToShow: 1,
                  slidesToScroll: 1,
                  arrows: false,
                  dots: true,
                  infinite: false
                });
              }
            } else {
              if ($slider.hasClass('slick-initialized')) {
                $slider.slick('unslick'); // destroy slider on desktop
              }
            }
          }

          // Run on load
          initExclusiveSlider();

          // Run on resize
          $(window).on('resize', function () {
            initExclusiveSlider();
          });
        });
    </script>
        <!-- jQuery -->
{% comment %} <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script> {% endcomment %}
    <script>
$(document).ready(function () {
  function initExclusiveSlider() {
    const $slider = $('.testimonial-wrapper .group-block-content').first();

    // ALWAYS initialize slider on all devices
    if (!$slider.hasClass('slick-initialized')) {
      $slider.slick({
        slidesToShow: 1,
        slidesToScroll: 1,
        arrows: true,
        dots: false,
        infinite: false
      });
    }
  }

  // Run on load
  initExclusiveSlider();

  // Run on resize
  $(window).on('resize', function () {
    initExclusiveSlider();
  });
});
</script>

  <script>
  document.addEventListener('DOMContentLoaded', function () {
    const homeMenuLink = document.querySelector('.menu-list__link[href="/"]');
    const currentPath = window.location.pathname;
    const homeRelatedPages = [
      '/pages/home-2'
    ];

    if (homeRelatedPages.includes(currentPath) && homeMenuLink) {
      homeMenuLink.classList.add('menu-list__link--active');
      homeMenuLink.setAttribute('aria-current', 'page');
    }
  });
</script>
