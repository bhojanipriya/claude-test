{% comment %}
  FILE: snippets/lookbook-pin.liquid
  Variables expected:
    prod — product object
    x    — horizontal % position
    y    — vertical % position
{% endcomment %}

<div class="lb__pin" style="left:{{ x }}%;top:{{ y }}%;">
  <button
    class="lb__pin-btn"
    type="button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label="{{ prod.title | escape }}"
  >
    <span class="lb__pin-pulse" aria-hidden="true"></span>
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <line x1="7" y1="2" x2="7" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <line x1="2" y1="7" x2="12" y2="7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>

  <div class="lb__popup" role="tooltip">
    <button class="lb__popup-close" type="button" aria-label="Close">
      <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
        <line x1="1" y1="1" x2="9" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="9" y1="1" x2="1" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
    <a href="{{ prod.url }}" class="lb__popup-link">
      {%- if prod.featured_image -%}
        <div class="lb__popup-media">
          {{
            prod.featured_image
            | image_url: width: 240
            | image_tag: loading: 'lazy', class: 'lb__popup-img',
              widths: '120,240',
              alt: prod.featured_image.alt | escape
          }}
        </div>
      {%- endif -%}
      <div class="lb__popup-body">
        {%- if prod.vendor != blank -%}
          <p class="lb__popup-vendor caption-with-letter-spacing">{{ prod.vendor }}</p>
        {%- endif -%}
        <p class="lb__popup-title">{{ prod.title }}</p>
        <p class="lb__popup-price">
          {%- if prod.compare_at_price > prod.price -%}
            <s class="lb__price-was">{{ prod.compare_at_price | money }}</s>
          {%- endif -%}
          <span class="lb__price-now{% if prod.compare_at_price > prod.price %} lb__price-now--sale{% endif %}">
            {{ prod.price | money }}
          </span>
        </p>
        <span class="lb__popup-cta button button--secondary">
          {{ 'products.product.view_full_details' | t | default: 'Shop now' }}
        </span>
      </div>
    </a>
  </div>
</div>